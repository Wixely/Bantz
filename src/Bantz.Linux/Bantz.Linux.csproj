<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bantz</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Partial trims only assemblies that declare themselves trimmable, which is the framework.
         AngleSharp, Silk.NET, and the CupriFace shell all resolve types by reflection, so they are
         copied whole rather than trimmed. -->
    <TrimMode>partial</TrimMode>
    <!-- Those dependencies raise trim analysis warnings that this repository cannot fix, and
         TreatWarningsAsErrors would otherwise fail the publish. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CupriFace.Shell" Version="0.20.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bantz.Core/Bantz.Core.csproj" />
    <ProjectReference Include="../Bantz.App/Bantz.App.csproj" />
    <ProjectReference Include="../Bantz.Capture/Bantz.Capture.csproj" />
  </ItemGroup>
</Project>
