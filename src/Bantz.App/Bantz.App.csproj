<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bantz</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CupriFace" Version="0.22.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bantz.Core/Bantz.Core.csproj" />
    <ProjectReference Include="../Bantz.Capture/Bantz.Capture.csproj" />
    <ProjectReference Include="../Bantz.Input/Bantz.Input.csproj" />
    <ProjectReference Include="../Bantz.Speech.Whisper/Bantz.Speech.Whisper.csproj" />
  </ItemGroup>
  <!-- CupriFace ships its binding generator in the core package; Bantz owns the small asset
       embedding rule because the resource generator/targets are not part of the package. -->
  <ItemGroup>
    <None Remove="Assets\**\*" />
    <EmbeddedResource Include="Assets\**\*">
      <LogicalName>Assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
